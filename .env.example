MONGO_USER=hilt
MONGO_PASSWORD=replace-with-a-long-random-password
# URL-encode username/password if they contain URI-reserved characters.
MONGODB_URI=mongodb://hilt:replace-with-a-long-random-password@mongodb:27017/HiltDB?authSource=admin
# Generate a long, random secret (at least 32 bytes) and keep it private.
JWT_SECRET=replace-with-a-long-random-secret
# S3 object storage. AWS SDK uses the default credential chain (e.g. IAM role,
# or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables).
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
