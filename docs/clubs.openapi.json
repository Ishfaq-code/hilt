              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session required or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable or club-management access unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale application revision or last administrator protection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque login session token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hilt_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "University": {
        "type": "object",
        "required": ["id", "slug", "name", "emailDomains"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "emailDomains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "Club": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "links",
          "university",
          "memberCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "university": {
            "$ref": "#/components/schemas/University"
          },
          "memberCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Review": {
        "type": "object",
        "required": ["decision", "message", "at", "revision"],
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["approve", "reject", "request_changes"]
          },
          "message": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "ApplicationInput": {
        "type": "object",
        "required": ["name", "description", "universityId", "contactEmail"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "universityId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "links": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https?://"
            }
          }
        },
        "additionalProperties": false
      },
      "ApplicationUpdate": {
        "type": "object",
        "required": [
          "name",
          "description",
          "universityId",
          "contactEmail",
          "revision"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "universityId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "links": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https?://"
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ReviewInput": {
        "type": "object",
        "required": ["decision", "message", "revision"],
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["approve", "reject", "request_changes"]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Member": {
        "type": "object",
        "required": ["id", "firstName", "lastName", "isAdministrator"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "isAdministrator": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Application": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Club"
          },
          {
            "type": "object",
            "required": [
              "approvalStatus",
              "contactEmail",
              "revision",
              "reviews",
              "createdAt",
              "updatedAt"
            ],
            "properties": {
              "approvalStatus": {
                "type": "string",
                "enum": ["pending", "approved", "rejected"]
              },
              "contactEmail": {
                "type": "string",
                "format": "email"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "reviews": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Review"
                }
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      }
    }
  }
}
