{
  "openapi": "3.0.3",
  "info": {
    "title": "Hilt Club Workflow API",
    "version": "1.1.0",
    "description": "Club applications, site-administrator review, discovery, membership, and shared club administration. UCF is the initial configured university. Email-domain matching is enforced, but ownership verification/recovery is explicitly deferred while email delivery is blocked. Registration and profile endpoints remain in auth.openapi.yaml. Private endpoints accept the browser hilt_session cookie or an explicit Bearer token. Cookie-authenticated writes require a matching Origin."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [],
  "paths": {
    "/api/universities": {
      "get": {
        "operationId": "listUniversities",
        "summary": "List configured universities and exact email domains",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["universities"],
                  "properties": {
                    "universities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/University"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/clubs": {
      "get": {
        "operationId": "discoverClubs",
        "summary": "Browse approved clubs without signing in",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["clubs", "total", "limit", "offset"],
                  "properties": {
                    "clubs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Club"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, IDs, pagination, or JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "universityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/clubs/{clubId}": {
      "get": {
        "operationId": "readPublicClub",
        "summary": "Read an approved club; pending/rejected IDs return 404",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["club"],
                  "properties": {
                    "club": {
                      "$ref": "#/components/schemas/Club"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, IDs, pagination, or JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable or club-management access unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "clubId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ]
      }
    },
    "/api/me/clubs": {
      "get": {
        "operationId": "myClubs",
        "summary": "Read own memberships, management capability, and site-admin capability",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["isSiteAdmin", "clubs"],
                  "properties": {
                    "isSiteAdmin": {
                      "type": "boolean"
                    },
                    "clubs": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Club"
                          },
                          {
                            "type": "object",
                            "required": ["canManage"],
                            "properties": {
                              "canManage": {
                                "type": "boolean"
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session required or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/api/club-applications": {
